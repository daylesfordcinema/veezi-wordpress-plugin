					"elements": []
				},
				{
					"id": "vzcard60",
					"elType": "widget",
					"widgetType": "button",
					"settings": {
						"text": "Book now",
						"link": {
							"url": "",
							"is_external": "",
							"nofollow": "",
							"custom_attributes": ""
						},
						"__dynamic__": {
							"link": "[elementor-tag id=\"vzcard60\" name=\"veezi-booking-url\" settings=\"%7B%7D\"]"
